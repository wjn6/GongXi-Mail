# Server
NODE_ENV=production
PORT=3000

# Database
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# SQLite 示例：DATABASE_PROVIDER=sqlite
# SQLite 示例：DATABASE_URL=file:/data/gongxi.db

# Redis (optional)
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=

# Security - CHANGE THESE IN PRODUCTION!
JWT_SECRET=replace-with-at-least-32-char-random-secret
JWT_EXPIRES_IN=2h
ENCRYPTION_KEY=replace-with-32-character-secret-key

# Default admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# Login protection
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_MINUTES=15
ADMIN_2FA_SECRET=
ADMIN_2FA_WINDOW=1

# API log retention
API_LOG_RETENTION_DAYS=30
API_LOG_CLEANUP_INTERVAL_MINUTES=60

# Token auto-refresh
TOKEN_REFRESH_ENABLED=true
TOKEN_REFRESH_INTERVAL_HOURS=12
TOKEN_REFRESH_CONCURRENCY=10
