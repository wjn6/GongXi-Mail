generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 管理员
// ============================================
model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  email        String?   @unique @db.VarChar(100)
  role         Role      @default(ADMIN)
  status       Status    @default(ACTIVE)
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?   @map("two_factor_secret") @db.Text
  twoFactorTempSecret String?   @map("two_factor_temp_secret") @db.Text
  lastLoginAt  DateTime? @map("last_login_at")
  lastLoginIp  String?   @map("last_login_ip") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  apiKeys ApiKey[]

  @@map("admins")
}

// ============================================
// API Key
// ============================================
model ApiKey {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  keyHash     String    @unique @map("key_hash") @db.VarChar(64)
  keyPrefix   String    @map("key_prefix") @db.VarChar(8)
  permissions Json?
  allowedGroupIds Json? @map("allowed_group_ids")
  allowedEmailIds Json? @map("allowed_email_ids")
  rateLimit   Int       @default(60) @map("rate_limit")
  status      Status    @default(ACTIVE)
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  usageCount  BigInt    @default(0) @map("usage_count")
  createdBy   Int       @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  creator     Admin        @relation(fields: [createdBy], references: [id])
  emailUsages EmailUsage[]
  apiLogs     ApiLog[]
  sendLogs    SendLog[]
  idempotencyRecords ResendIdempotency[]

  @@map("api_keys")
}

// ============================================
// 邮箱分组
// ============================================
model EmailGroup {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  fetchStrategy MailFetchStrategy @default(GRAPH_FIRST) @map("fetch_strategy")
  // 换取令牌使用的微软登录端点：取决于 client_id 在微软注册时支持的账号类型
  oauthTenant   OAuthTenant       @default(CONSUMERS) @map("oauth_tenant")
  // 发信池配置（默认关闭）
  sendEnabled         Boolean      @default(false) @map("send_enabled")
  sendStrategy        SendStrategy @default(LEAST_USED) @map("send_strategy")
  sendDailyLimit      Int          @default(30) @map("send_daily_limit")
  sendIntervalSeconds Int          @default(60) @map("send_interval_seconds")
  sendMaxRecipients   Int          @default(10) @map("send_max_recipients")
  // 发信通道：AUTO 填了发件人名称时走 SMTP（Graph 会忽略自定义名称），否则走 Graph；通道不可用时互为备用
  sendTransport       SendTransport @default(AUTO) @map("send_transport")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  emails   EmailAccount[]
  sendLogs SendLog[]

  @@map("email_groups")
}

// ============================================
// 邮箱账户
// ============================================
model EmailAccount {
  id           Int         @id @default(autoincrement())
  email        String      @unique @db.VarChar(255)
  clientId     String      @map("client_id") @db.VarChar(100)
  password     String?     @db.VarChar(255)
  refreshToken String      @map("refresh_token") @db.Text
  // 单独用于 IMAP / SMTP（outlook.office.com）的凭据（加密）：Graph 与 IMAP 由两个应用分别授权的账号各有一份 refresh token；
  // 为空时 IMAP / SMTP 也使用上面的主凭据
  imapClientId     String? @map("imap_client_id") @db.VarChar(100)
  imapRefreshToken String? @map("imap_refresh_token") @db.Text
  status       EmailStatus @default(ACTIVE)
  groupId      Int?        @map("group_id")
  lastCheckAt  DateTime?   @map("last_check_at")
  tokenRefreshedAt DateTime? @map("token_refreshed_at")
  errorMessage String?     @map("error_message") @db.Text
  // 发信状态
  sendCapability    SendCapability @default(UNKNOWN) @map("send_capability")
  sendCheckedAt     DateTime?      @map("send_checked_at")
  lastSentAt        DateTime?      @map("last_sent_at")
  sendCooldownUntil DateTime?      @map("send_cooldown_until")
  sendErrorMessage  String?        @map("send_error_message") @db.Text
  // SMTP 发信（OAuth XOAUTH2）能力：令牌含 SMTP.Send 且邮箱未禁用 SMTP AUTH
  smtpCapability    SendCapability @default(UNKNOWN) @map("smtp_capability")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  group   EmailGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  usages   EmailUsage[]
  apiLogs  ApiLog[]
  sendLogs SendLog[]

  @@map("email_accounts")
}

// ============================================
// 系统配置
// ============================================
model SystemConfig {
  id                        Int      @id @default(1)
  tokenRefreshEnabled       Boolean  @default(true) @map("token_refresh_enabled")
  tokenRefreshIntervalHours Int      @default(12) @map("token_refresh_interval_hours")
  tokenRefreshConcurrency   Int      @default(10) @map("token_refresh_concurrency")
  tokenRefreshNextRunAt     DateTime? @map("token_refresh_next_run_at")
  tokenRefreshLastAutoCompletedAt DateTime? @map("token_refresh_last_auto_completed_at")
  tokenRefreshLastAutoTotal Int?     @map("token_refresh_last_auto_total")
  tokenRefreshLastAutoSuccess Int?   @map("token_refresh_last_auto_success")
  tokenRefreshLastAutoFailed Int?    @map("token_refresh_last_auto_failed")
  tokenRefreshLastAutoDurationMs Int? @map("token_refresh_last_auto_duration_ms")
  tokenRefreshLastAutoFailures Json? @map("token_refresh_last_auto_failures")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("system_config")
}

// ============================================
// 邮箱使用记录（邮箱池）
// ============================================
model EmailUsage {
  id             Int              @id @default(autoincrement())
  apiKeyId       Int              @map("api_key_id")
  emailAccountId Int              @map("email_account_id")
  // CLAIMED：已领取（租约中，超时自动回收）；COMPLETED：已用完（不再分配）
  status         EmailUsageStatus @default(COMPLETED)
  usedAt         DateTime         @default(now()) @map("used_at")
  leaseExpiresAt DateTime?        @map("lease_expires_at")
  completedAt    DateTime?        @map("completed_at")

  apiKey       ApiKey       @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  emailAccount EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, emailAccountId])
  @@index([status, leaseExpiresAt])
  @@map("email_usage")
}

// ============================================
// API 调用日志
// ============================================
model ApiLog {
  id             BigInt    @id @default(autoincrement())
  apiKeyId       Int?      @map("api_key_id")
  emailAccountId Int?      @map("email_account_id")
  action         String    @db.VarChar(50)
  requestIp      String?   @map("request_ip") @db.VarChar(45)
  responseCode   Int?      @map("response_code")
  responseTimeMs Int?      @map("response_time_ms")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  apiKey       ApiKey?       @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  emailAccount EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)

  @@index([apiKeyId])
  @@index([emailAccountId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@map("api_logs")
}

// ============================================
// 发信记录（Resend 兼容接口 / 后台测试发信）
// id 即 Resend 接口返回的邮件 ID
// ============================================
model SendLog {
  id               String     @id @db.Uuid
  source           SendSource
  status           SendStatus
  apiKeyId         Int?       @map("api_key_id")
  adminId          Int?       @map("admin_id")
  groupId          Int?       @map("group_id")
  emailAccountId   Int?       @map("email_account_id")
  // 请求中的 from 原文；实际发件地址见 fromAddress
  requestedFrom    String     @map("requested_from") @db.VarChar(512)
  fromName         String?    @map("from_name") @db.VarChar(255)
  fromAddress      String?    @map("from_address") @db.VarChar(255)
  toAddresses      Json       @map("to_addresses")
  ccAddresses      Json?      @map("cc_addresses")
  bccAddresses     Json?      @map("bcc_addresses")
  replyTo          Json?      @map("reply_to")
  subject          String     @db.VarChar(998)
  html             String?    @db.Text
  text             String?    @db.Text
  headers          Json?
  tags             Json?
  recipientCount   Int        @map("recipient_count")
  attachmentCount  Int        @default(0) @map("attachment_count")
  attachmentBytes  Int        @default(0) @map("attachment_bytes")
  attempts         Int        @default(0)
  // 实际使用的发信通道：GRAPH / SMTP / GRAPH_FALLBACK（SMTP 不可用改用 Graph，发件人名称不生效）
  transport        String?    @db.VarChar(20)
  errorCode        String?    @map("error_code") @db.VarChar(64)
  errorMessage     String?    @map("error_message") @db.Text
  batchId          String?    @map("batch_id") @db.Uuid
  batchIndex       Int?       @map("batch_index")
  requestIp        String?    @map("request_ip") @db.VarChar(45)
  createdAt        DateTime   @default(now()) @map("created_at")
  // 最近一次分配发件账号的时间（用于按账号统计 24 小时发信量）
  attemptedAt      DateTime?  @map("attempted_at")
  sentAt           DateTime?  @map("sent_at")
  // 排队邮件下次尝试时间 / 被发送任务领取的时间
  nextAttemptAt    DateTime?  @map("next_attempt_at")
  lockedAt         DateTime?  @map("locked_at")

  apiKey       ApiKey?       @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  group        EmailGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  emailAccount EmailAccount? @relation(fields: [emailAccountId], references: [id], onDelete: SetNull)

  @@index([emailAccountId, status, attemptedAt])
  @@index([apiKeyId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([groupId, createdAt])
  @@index([batchId])
  @@index([createdAt])
  @@map("send_logs")
}

// ============================================
// Resend 兼容接口的幂等记录（Idempotency-Key，24 小时有效）
// ============================================
model ResendIdempotency {
  id             Int               @id @default(autoincrement())
  apiKeyId       Int               @map("api_key_id")
  endpoint       String            @db.VarChar(32)
  key            String            @db.VarChar(256)
  requestHash    String            @map("request_hash") @db.VarChar(64)
  status         IdempotencyStatus
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @default(now()) @map("created_at")
  expiresAt      DateTime          @map("expires_at")

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, endpoint, key])
  @@index([expiresAt])
  @@map("resend_idempotency")
}

// ============================================
// 枚举
// ============================================
enum Role {
  SUPER_ADMIN
  ADMIN
}

enum Status {
  ACTIVE
  DISABLED
}

enum EmailStatus {
  ACTIVE
  ERROR
  DISABLED
}

enum SendStrategy {
  LEAST_USED
  ROUND_ROBIN
  RANDOM
}

enum SendCapability {
  UNKNOWN
  ALLOWED
  DENIED
}

enum SendSource {
  RESEND
  ADMIN
}

enum SendStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum EmailUsageStatus {
  CLAIMED
  COMPLETED
}

enum SendTransport {
  AUTO
  GRAPH
  SMTP
}

enum OAuthTenant {
  CONSUMERS
  ORGANIZATIONS
  COMMON
}

enum MailFetchStrategy {
  GRAPH_FIRST
  IMAP_FIRST
  GRAPH_ONLY
  IMAP_ONLY
}
